{
  "name": "maze-hunter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:levels": "vitest run tests/levels.test.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "playwright test",
    "check:public-env": "node scripts/check-public-env.mjs",
    "prebuild": "node scripts/clean-legacy.mjs",
    "build:realtime": "tsc --noEmit -p realtime/tsconfig.json && esbuild realtime/server.ts --bundle --platform=node --format=esm --packages=external --outfile=build/realtime/server.mjs",
    "start:realtime": "node build/realtime/server.mjs",
    "dev:realtime": "node --env-file=.env.local node_modules/vite/bin/vite.js --host 0.0.0.0",
    "start:realtime:local": "node --env-file=.env.realtime build/realtime/server.mjs"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "phaser": "^3.90.0",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.30",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  }
}
