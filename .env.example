# Firebase Web identifiers. Existing public defaults remain in src/services/firebase-web-config.ts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Required for online rooms: copy the EXACT URL from the EXISTING Realtime Database console.
VITE_FIREBASE_DATABASE_URL=
# Netlify Functions server environment ONLY. Never prefix these with VITE_.
# JSON service-account credential stored privately in Netlify environment settings.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Same existing Realtime Database as the client URL above.
FIREBASE_DATABASE_URL=
